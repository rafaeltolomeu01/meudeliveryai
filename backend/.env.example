# ==============================================================================
#  MeuDeliveryAI — Backend Environment Variables (.env.example)
# ==============================================================================

PORT=3001
NODE_ENV=production
APP_URL=
FRONTEND_URL=

# Banco de dados (prefixo DATABASE_* ou DB_*)
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=meudeliveryai
DATABASE_PORT=3306
DATABASE_SSL=true

# Segurança e JWT
JWT_SECRET=sua_chave_secreta_super_forte_para_producao_minimo_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# OpenAI IA Atendente
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=meudelivery2026whatsapp
