# ==============================================================================
#  MeuDeliveryAI — Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
#  Instruções: Copie este arquivo como ".env" no backend ou use na configuração do Render.
# ==============================================================================

# --- AMBIENTE E PORTA ---
# Porta em que o backend irá escutar (no Render, a variável PORT é injetada automaticamente)
PORT=3001
# Defina como 'production' em produção ou 'development' localmente
NODE_ENV=production
# URL principal do servidor backend (ex: https://meu-delivery-backend.onrender.com)
APP_URL=
# URL principal da aplicação frontend (ex: https://meu-delivery.onrender.com)
FRONTEND_URL=

# --- BANCO DE DADOS MYSQL (PADRÃO RENDER / EXTERNO) ---
# O backend é compatível tanto com o prefixo DATABASE_* quanto DB_*
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=meudeliveryai
DATABASE_PORT=3306

# Se o banco de dados em nuvem exigir conexão segura/criptografada (SSL), defina como 'true'.
# A maioria dos bancos externos gerenciados (como Aiven, AWS RDS, Render, etc.) exige SSL ativo.
DATABASE_SSL=true

# --- SEGURANÇA E JWT ---
# Chave secreta de criptografia para tokens JWT (USE UMA CHAVE LONGA E SEGURA EM PRODUÇÃO!)
JWT_SECRET=sua_chave_secreta_super_forte_para_producao_minimo_32_chars
# Duração de expiração dos tokens JWT
JWT_EXPIRES_IN=7d
# Nível de custo do hash de senha do bcrypt (padrão: 12)
BCRYPT_SALT_ROUNDS=12

# --- INTELIGÊNCIA ARTIFICIAL (OPENAI CHATGPT) ---
# Chave de API do OpenAI (ChatGPT) obtida no painel da OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo do ChatGPT a ser utilizado (Recomendado: gpt-4o-mini por custo-benefício)
OPENAI_MODEL=gpt-4o-mini

# --- UPLOADS DE IMAGENS ---
# Diretório onde as imagens dos produtos e logos serão salvas localmente no disco
UPLOAD_DIR=uploads
# Tamanho máximo de arquivo de imagem (em bytes). Ex: 5242880 = 5MB
MAX_FILE_SIZE=5242880

# --- INTEGRAÇÃO WHATSAPP (EVOLUTION API) ---
# URL da sua instância Evolution API (ex: http://localhost:8080 ou URL de hospedagem na nuvem)
EVOLUTION_API_URL=http://localhost:8080
# Chave de API global (ApiKey) definida na sua Evolution API
EVOLUTION_API_KEY=meudelivery2026whatsapp
